# Copy this file to .env. DEMO mode is safe for local testing.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=ChangeThisAdminPassword!
PAYMENT_MODE=DEMO
BASE_URL=http://127.0.0.1:5000
DATABASE_PATH=tiketi360.db

# Only configure these after registering an approved Daraja app.
# For sandbox testing use Safaricom Daraja sandbox credentials.
# Set PAYMENT_MODE=MPESA only after configuring every value below.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR-PUBLIC-HTTPS-DOMAIN/api/mpesa/callback
